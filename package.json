{
  "name": "asprog-design-system",
  "version": "0.13.0",
  "private": true,
  "description": "El sistema de diseño y el método de documentación de los proyectos de Andrés R. Sotelo, con sus plugins de Claude Code.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AS-prog/asprog-design-system.git"
  },
  "files": [
    "system/astro/",
    "system/assets/",
    "system/css/",
    "system/fonts/",
    "system/js/",
    "system/tokens.css",
    "system/tokens.json"
  ],
  "exports": {
    ".": "./system/tokens.css",
    "./astro": "./system/astro/index.js",
    "./astro/*": "./system/astro/*",
    "./tokens.css": "./system/tokens.css",
    "./tokens.json": "./system/tokens.json",
    "./css/*": "./system/css/*",
    "./fonts/*": "./system/fonts/*",
    "./assets/*": "./system/assets/*",
    "./js/*": "./system/js/*"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "example": "uv run --no-project --with markdown python plugins/documentation/scripts/site.py vendor --root examples/sample-project && uv run --no-project --with markdown python plugins/documentation/scripts/site.py build --root examples/sample-project",
    "test": "node scripts/test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "astro": ">=5",
    "three": "0.181.2"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  }
}
